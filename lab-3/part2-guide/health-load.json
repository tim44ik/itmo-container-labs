{
  "apiVersion": "v1",
  "kind": "Pod",
  "metadata": {
    "name": "shop-health-load",
    "namespace": "shop",
    "labels": {
      "app": "shop-health-load",
      "app.kubernetes.io/name": "shop-health-load"
    }
  },
  "spec": {
    "restartPolicy": "Never",
    "automountServiceAccountToken": false,
    "securityContext": {
      "runAsNonRoot": true,
      "runAsUser": 65532,
      "runAsGroup": 65532,
      "seccompProfile": {
        "type": "RuntimeDefault"
      }
    },
    "containers": [
      {
        "name": "load",
        "image": "docker.io/library/busybox:1.37.0",
        "securityContext": {
          "readOnlyRootFilesystem": true,
          "privileged": false,
          "allowPrivilegeEscalation": false,
          "capabilities": {
            "drop": [
              "ALL"
            ]
          }
        },
        "resources": {
          "requests": {
            "cpu": "25m",
            "memory": "16Mi"
          },
          "limits": {
            "cpu": "200m",
            "memory": "64Mi"
          }
        },
        "command": [
          "sh",
          "-c",
          "while true; do\n  if wget -q -T 2 -O /dev/null http://shop-api.shop.svc.cluster.local:8080/health; then\n    echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) OK\"\n  else\n    echo \"$(date -u +%Y-%m-%dT%H:%M:%SZ) FAIL\"\n  fi\n  sleep 0.2\ndone"
        ]
      }
    ]
  }
}
