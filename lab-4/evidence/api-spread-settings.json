[
    {
        "labelSelector": {
            "matchLabels": {
                "app.kubernetes.io/component": "api",
                "app.kubernetes.io/instance": "shop",
                "app.kubernetes.io/name": "shop"
            }
        },
        "matchLabelKeys": [
